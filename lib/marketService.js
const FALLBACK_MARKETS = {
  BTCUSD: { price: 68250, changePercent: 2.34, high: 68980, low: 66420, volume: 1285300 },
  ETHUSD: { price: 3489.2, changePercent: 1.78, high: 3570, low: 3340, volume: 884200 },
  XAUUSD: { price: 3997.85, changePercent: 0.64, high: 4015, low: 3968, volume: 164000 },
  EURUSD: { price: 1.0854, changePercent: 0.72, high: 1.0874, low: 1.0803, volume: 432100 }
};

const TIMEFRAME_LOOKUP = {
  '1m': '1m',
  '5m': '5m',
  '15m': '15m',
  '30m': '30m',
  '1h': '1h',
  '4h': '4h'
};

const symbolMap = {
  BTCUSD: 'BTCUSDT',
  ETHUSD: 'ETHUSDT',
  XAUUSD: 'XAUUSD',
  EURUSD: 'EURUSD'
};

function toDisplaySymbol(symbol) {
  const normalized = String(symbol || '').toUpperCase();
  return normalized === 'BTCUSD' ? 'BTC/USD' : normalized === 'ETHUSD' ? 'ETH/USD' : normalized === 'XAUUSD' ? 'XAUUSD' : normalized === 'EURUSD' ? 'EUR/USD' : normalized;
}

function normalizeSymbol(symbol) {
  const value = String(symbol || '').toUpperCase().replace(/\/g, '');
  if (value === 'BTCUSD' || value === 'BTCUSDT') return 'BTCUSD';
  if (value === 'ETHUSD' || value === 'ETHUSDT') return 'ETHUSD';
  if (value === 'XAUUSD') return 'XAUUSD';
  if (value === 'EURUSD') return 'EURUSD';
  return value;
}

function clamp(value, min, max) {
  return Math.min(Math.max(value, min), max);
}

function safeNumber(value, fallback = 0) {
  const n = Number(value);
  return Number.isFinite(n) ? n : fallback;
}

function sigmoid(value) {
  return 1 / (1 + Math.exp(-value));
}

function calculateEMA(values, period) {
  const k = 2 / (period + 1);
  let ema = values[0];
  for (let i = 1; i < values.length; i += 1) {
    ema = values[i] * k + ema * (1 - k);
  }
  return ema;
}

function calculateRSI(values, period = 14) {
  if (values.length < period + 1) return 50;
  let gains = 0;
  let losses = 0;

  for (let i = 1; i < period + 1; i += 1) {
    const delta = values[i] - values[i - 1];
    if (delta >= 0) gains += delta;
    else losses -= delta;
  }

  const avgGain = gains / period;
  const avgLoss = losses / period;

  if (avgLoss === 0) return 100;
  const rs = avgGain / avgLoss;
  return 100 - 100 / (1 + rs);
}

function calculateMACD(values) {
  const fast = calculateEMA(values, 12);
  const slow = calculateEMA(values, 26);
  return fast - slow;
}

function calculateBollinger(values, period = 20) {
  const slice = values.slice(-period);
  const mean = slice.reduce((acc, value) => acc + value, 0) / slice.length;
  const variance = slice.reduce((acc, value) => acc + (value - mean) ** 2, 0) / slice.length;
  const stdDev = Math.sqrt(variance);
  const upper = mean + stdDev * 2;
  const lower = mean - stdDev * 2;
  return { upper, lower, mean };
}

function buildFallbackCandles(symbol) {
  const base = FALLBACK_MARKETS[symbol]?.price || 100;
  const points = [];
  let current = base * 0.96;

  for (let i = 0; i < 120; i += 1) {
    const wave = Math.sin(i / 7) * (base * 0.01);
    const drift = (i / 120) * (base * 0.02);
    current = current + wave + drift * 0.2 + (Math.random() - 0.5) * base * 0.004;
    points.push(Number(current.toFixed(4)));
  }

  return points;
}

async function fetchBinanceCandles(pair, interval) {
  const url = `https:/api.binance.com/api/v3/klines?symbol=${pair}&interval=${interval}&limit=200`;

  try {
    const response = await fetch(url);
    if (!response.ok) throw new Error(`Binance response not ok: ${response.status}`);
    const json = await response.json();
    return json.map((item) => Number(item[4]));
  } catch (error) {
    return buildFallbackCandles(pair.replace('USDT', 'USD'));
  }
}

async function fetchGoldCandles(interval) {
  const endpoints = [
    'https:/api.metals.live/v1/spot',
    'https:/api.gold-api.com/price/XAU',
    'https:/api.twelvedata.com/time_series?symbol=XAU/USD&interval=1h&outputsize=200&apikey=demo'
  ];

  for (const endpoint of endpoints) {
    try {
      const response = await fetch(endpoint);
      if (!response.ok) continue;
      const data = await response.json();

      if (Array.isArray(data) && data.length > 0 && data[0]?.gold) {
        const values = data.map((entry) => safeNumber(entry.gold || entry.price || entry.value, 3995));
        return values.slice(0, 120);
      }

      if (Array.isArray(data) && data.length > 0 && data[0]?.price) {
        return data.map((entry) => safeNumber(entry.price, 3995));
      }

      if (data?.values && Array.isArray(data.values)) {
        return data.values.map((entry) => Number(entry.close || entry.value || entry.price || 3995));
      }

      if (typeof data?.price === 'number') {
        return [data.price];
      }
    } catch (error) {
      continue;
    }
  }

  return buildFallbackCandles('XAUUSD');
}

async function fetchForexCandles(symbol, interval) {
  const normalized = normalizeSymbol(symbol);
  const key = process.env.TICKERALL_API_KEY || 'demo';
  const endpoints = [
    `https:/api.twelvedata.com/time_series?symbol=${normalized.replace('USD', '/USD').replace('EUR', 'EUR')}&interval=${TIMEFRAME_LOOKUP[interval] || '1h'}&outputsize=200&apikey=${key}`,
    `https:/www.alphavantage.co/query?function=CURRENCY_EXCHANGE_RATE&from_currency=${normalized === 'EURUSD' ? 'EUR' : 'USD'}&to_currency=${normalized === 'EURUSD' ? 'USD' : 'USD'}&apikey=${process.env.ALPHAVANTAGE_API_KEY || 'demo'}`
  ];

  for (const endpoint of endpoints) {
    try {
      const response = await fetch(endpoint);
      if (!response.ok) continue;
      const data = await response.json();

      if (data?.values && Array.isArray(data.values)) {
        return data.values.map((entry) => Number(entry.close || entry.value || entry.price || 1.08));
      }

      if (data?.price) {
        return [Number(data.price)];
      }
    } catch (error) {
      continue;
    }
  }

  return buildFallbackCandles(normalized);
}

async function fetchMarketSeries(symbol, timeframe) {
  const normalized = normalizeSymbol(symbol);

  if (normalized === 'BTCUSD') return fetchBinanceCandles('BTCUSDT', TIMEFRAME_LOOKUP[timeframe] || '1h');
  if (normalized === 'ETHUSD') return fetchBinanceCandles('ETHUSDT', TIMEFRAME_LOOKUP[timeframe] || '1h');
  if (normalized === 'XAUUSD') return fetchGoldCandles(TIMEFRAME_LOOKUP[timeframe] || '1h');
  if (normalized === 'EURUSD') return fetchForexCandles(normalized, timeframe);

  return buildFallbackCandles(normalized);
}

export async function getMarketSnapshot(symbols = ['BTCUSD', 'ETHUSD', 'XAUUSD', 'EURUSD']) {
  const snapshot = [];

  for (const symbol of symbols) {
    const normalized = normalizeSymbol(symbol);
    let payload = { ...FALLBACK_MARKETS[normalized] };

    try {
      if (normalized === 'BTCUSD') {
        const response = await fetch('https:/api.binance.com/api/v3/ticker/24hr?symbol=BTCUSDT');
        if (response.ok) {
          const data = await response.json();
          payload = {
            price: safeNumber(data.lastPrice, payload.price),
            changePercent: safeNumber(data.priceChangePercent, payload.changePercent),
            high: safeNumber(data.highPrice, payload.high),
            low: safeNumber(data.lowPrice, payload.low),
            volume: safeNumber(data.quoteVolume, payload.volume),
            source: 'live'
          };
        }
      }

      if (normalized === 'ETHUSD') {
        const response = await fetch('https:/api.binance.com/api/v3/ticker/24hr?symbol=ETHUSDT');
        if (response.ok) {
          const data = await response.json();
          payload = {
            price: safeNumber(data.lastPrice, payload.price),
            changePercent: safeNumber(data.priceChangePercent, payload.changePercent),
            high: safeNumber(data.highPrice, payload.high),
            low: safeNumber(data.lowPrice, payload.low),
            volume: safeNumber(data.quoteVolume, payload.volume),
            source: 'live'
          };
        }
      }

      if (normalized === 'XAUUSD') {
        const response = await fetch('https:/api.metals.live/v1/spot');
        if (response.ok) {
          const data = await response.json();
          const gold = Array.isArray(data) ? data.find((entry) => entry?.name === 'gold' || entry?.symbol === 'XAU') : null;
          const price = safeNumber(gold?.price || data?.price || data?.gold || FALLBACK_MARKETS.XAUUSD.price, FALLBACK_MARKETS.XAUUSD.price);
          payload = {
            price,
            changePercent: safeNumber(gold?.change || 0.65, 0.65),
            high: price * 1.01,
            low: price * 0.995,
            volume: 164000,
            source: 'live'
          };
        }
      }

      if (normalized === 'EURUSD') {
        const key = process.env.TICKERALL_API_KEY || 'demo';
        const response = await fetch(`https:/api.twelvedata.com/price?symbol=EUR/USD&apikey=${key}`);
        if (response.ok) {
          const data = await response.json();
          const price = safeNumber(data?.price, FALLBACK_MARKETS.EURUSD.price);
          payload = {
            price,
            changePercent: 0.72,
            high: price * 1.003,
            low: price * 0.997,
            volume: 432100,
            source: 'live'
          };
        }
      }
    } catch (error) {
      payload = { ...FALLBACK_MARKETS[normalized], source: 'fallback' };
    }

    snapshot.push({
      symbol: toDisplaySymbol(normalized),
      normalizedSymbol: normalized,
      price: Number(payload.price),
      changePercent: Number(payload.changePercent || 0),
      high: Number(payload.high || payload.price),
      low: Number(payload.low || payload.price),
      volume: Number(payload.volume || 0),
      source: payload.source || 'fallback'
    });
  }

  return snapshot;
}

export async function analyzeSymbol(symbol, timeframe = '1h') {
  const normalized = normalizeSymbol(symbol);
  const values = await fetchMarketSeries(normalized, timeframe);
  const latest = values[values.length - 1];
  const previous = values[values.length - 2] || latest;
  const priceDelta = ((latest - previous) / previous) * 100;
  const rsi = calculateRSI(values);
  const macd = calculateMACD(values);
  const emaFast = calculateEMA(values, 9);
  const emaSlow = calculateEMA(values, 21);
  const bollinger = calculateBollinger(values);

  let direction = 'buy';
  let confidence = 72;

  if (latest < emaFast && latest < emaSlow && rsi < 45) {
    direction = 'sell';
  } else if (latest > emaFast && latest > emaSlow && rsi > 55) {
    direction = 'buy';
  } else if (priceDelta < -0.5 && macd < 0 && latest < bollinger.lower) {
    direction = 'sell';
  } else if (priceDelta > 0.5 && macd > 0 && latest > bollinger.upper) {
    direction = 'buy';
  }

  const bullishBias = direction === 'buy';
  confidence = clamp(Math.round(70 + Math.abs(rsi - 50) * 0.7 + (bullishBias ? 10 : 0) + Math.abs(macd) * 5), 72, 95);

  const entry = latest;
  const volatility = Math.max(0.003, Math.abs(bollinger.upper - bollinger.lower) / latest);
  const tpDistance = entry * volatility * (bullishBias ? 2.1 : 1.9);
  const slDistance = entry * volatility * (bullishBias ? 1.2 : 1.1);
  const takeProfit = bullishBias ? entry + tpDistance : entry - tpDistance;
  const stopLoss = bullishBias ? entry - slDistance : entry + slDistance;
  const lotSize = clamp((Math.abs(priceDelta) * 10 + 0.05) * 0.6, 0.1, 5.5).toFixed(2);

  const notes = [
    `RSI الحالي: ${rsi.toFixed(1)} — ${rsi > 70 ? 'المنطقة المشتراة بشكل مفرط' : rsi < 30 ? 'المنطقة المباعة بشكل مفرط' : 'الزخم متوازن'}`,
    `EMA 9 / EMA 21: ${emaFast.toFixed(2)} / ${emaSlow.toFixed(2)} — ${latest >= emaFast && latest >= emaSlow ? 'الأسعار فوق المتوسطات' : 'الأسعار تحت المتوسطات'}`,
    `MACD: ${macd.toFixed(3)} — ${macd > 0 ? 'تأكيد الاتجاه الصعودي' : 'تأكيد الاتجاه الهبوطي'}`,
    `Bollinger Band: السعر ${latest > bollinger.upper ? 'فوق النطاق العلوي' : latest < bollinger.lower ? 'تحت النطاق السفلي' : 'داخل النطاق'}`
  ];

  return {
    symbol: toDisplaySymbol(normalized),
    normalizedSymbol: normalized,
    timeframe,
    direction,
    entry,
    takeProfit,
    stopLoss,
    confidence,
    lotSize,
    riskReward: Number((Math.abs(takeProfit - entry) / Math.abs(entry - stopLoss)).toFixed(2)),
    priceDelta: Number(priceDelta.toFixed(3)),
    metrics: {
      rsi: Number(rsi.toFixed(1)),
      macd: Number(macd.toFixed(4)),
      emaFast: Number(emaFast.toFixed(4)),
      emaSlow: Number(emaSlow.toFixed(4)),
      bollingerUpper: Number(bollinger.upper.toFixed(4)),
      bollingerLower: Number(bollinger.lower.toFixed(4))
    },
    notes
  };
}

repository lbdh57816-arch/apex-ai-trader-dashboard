import { analyzeSymbol } from '../lib/marketService.js';

export default async function handler(req, res) {
  try {
    const symbol = String(req.query?.symbol || 'BTCUSD');
    const timeframe = String(req.query?.timeframe || '1h');
    const result = await analyzeSymbol(symbol, timeframe);
    res.status(200).json({ ok: true, ...result });
  } catch (error) {
    res.status(500).json({ ok: false, error: error.message || 'analysis failed' });
  }
}
