:root {
  --bg: #07111f;
  --bg-soft: #0d1b2b;
  --panel: rgba(12, 21, 31, 0.96);
  --panel-alt: rgba(18, 34, 49, 0.97);
  --line: rgba(148, 163, 184, 0.18);
  --text: #edf7ff;
  --muted: #96a9be;
  --green: #15d19c;
  --green-soft: rgba(21, 209, 156, 0.12);
  --red: #ff5b6e;
  --red-soft: rgba(255, 91, 110, 0.1);
  --blue: #4aa4ff;
  --purple: #8e7bff;
  --amber: #f9bf4b;
  --shadow: 0 18px 45px rgba(8, 15, 25, 0.5);
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  background: radial-gradient(circle at top left, #10243d, var(--bg) 38%, #050d16 100%);
  color: var(--text);
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

button, input, select {
  font: inherit;
}

.app-shell {
  width: min(1460px, 96vw);
  margin: 28px auto;
  padding: 20px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 18px 24px;
  background: rgba(9, 18, 29, 0.82);
  border: 1px solid var(--line);
  border-radius: 22px;
  box-shadow: var(--shadow);
  backdrop-filter: blur(12px);
  margin-bottom: 18px;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 14px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  display: grid;
  place-items: center;
  font-weight: 900;
  color: #081821;
  background: linear-gradient(135deg, var(--green), var(--blue));
  box-shadow: 0 12px 30px rgba(74,164,255,0.35);
}

.brand-name {
  font-size: 18px;
  font-weight: 900;
}

.brand-wrap small {
  color: var(--muted);
  font-size: 11px;
  font-weight: 700;
}

.nav {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.nav-pill {
  padding: 10px 14px;
  border-radius: 12px;
  border: 1px solid transparent;
  background: rgba(255,255,255,0.02);
  color: var(--muted);
  cursor: pointer;
  font-weight: 700;
}

.nav-pill.active {
  background: linear-gradient(135deg, rgba(74,164,255,0.10), rgba(21,209,156,0.08));
  border-color: rgba(74,164,255,0.20);
  color: var(--text);
}

.profile-box {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 12px;
  border-radius: 14px;
  background: rgba(255,255,255,0.02);
  border: 1px solid var(--line);
}

.avatar {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #facc15, #f97316);
  color: #111827;
  font-weight: 900;
}

.profile-name {
  font-weight: 800;
}

.profile-role {
  color: var(--muted);
  font-size: 12px;
}

.dashboard {
  display: grid;
  grid-template-columns: 290px minmax(0, 1fr) 350px;
  gap: 18px;
}

.panel {
  background: linear-gradient(180deg, rgba(17, 29, 43, 0.94), rgba(11, 18, 28, 0.94));
  border: 1px solid var(--line);
  border-radius: 22px;
  box-shadow: var(--shadow);
}

.side-panel {
  padding: 18px 16px;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 14px;
  padding: 0 4px;
}

.section-head h3 {
  margin: 0;
  font-size: 16px;
}

.live-badge, .mini-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 7px 10px;
  border-radius: 999px;
  font-size: 11px;
  line-height: 1;
  font-weight: 800;
  background: rgba(21, 209, 156, 0.1);
  color: var(--green);
  border: 1px solid rgba(21, 209, 156, 0.25);
}

.market-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.market-item {
  width: 100%;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(148,163,184,0.18);
  border-radius: 16px;
  padding: 14px;
  color: var(--text);
  text-align: right;
  cursor: pointer;
}

.market-item.active {
  border-color: rgba(74,164,255,0.2);
  background: linear-gradient(135deg, rgba(74,164,255,0.08), rgba(21,209,156,0.04));
}

.market-top,
.market-meta,
.metric-row,
.analysis-summary,
.chart-top,
.analysis-box-head,
.selector-row,
.signal-card-layout {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.market-top {
  margin-bottom: 8px;
  font-weight: 800;
}

.pair-tag {
  padding: 6px 8px;
  font-size: 10px;
  font-weight: 800;
  border-radius: 999px;
  border: 1px solid rgba(21,209,156,0.2);
  background: rgba(21,209,156,0.08);
  color: var(--green);
}

.market-meta {
  color: var(--muted);
  font-size: 12px;
  font-weight: 700;
}

.market-meta strong {
  font-size: 19px;
  color: var(--text);
}

.positive {
  color: var(--green);
}

.negative {
  color: var(--red);
}

.center-panel {
  padding: 18px;
}

.market-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
  padding: 0 4px;
}

.market-title-group {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}

.pair-title {
  font-size: 30px;
  font-weight: 900;
  letter-spacing: 0.4px;
}

.price-row {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.price-value {
  font-size: 32px;
  font-weight: 900;
}

.trend-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 10px;
  border-radius: 999px;
  font-size: 14px;
  font-weight: 800;
}

.trend-pill.positive {
  background: rgba(21,209,156,0.08);
  border: 1px solid rgba(21,209,156,0.22);
  color: var(--green);
}

.trend-pill.negative {
  background: rgba(255,91,110,0.08);
  border: 1px solid rgba(255,91,110,0.18);
  color: var(--red);
}

.market-direction {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 88px;
  padding: 8px 12px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 800;
}

.market-direction.buy {
  background: rgba(21,209,156,0.12);
  border: 1px solid rgba(21,209,156,0.24);
  color: var(--green);
}

.market-direction.sell {
  background: rgba(255,91,110,0.10);
  border: 1px solid rgba(255,91,110,0.18);
  color: var(--red);
}

.chart-card {
  background: linear-gradient(180deg, rgba(12, 19, 30, 0.97), rgba(8, 15, 25, 0.96));
  border: 1px solid var(--line);
  border-radius: 18px;
  min-height: 280px;
  padding: 14px 12px 8px;
}

.chart-top {
  margin-bottom: 12px;
  padding: 2px 6px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 800;
}

.time-range {
  display: flex;
  align-items: center;
  gap: 10px;
}

.time-range span {
  padding: 4px 6px;
  border-radius: 8px;
  transition: 0.2s ease;
}

.timeframe-active {
  background: rgba(74,164,255,0.12);
  color: var(--text);
}

.chart-svg {
  width: 100%;
  height: 240px;
  display: block;
}

.analysis-card {
  margin-top: 18px;
  background: rgba(13, 22, 33, 0.92);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 16px;
}

.soft-label {
  color: var(--muted);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.4px;
}

.selector-row {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.selector-row select {
  min-width: 140px;
  padding: 10px 12px;
  border-radius: 12px;
  border: 1px solid var(--line);
  background: rgba(255,255,255,0.02);
  color: var(--text);
}

.analysis-summary {
  margin-top: 12px;
  margin-bottom: 14px;
}

.signal-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 12px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 900;
}

.signal-badge.buy {
  background: rgba(21,209,156,0.12);
  border: 1px solid rgba(21,209,156,0.3);
  color: var(--green);
}

.signal-badge.sell {
  background: rgba(255,91,110,0.08);
  border: 1px solid rgba(255,91,110,0.18);
  color: var(--red);
}

.confidence-tag {
  font-size: 12px;
  color: var(--muted);
  font-weight: 800;
}

.signal-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

.signal-card {
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(148,163,184,0.14);
  border-radius: 14px;
  padding: 12px 12px 10px;
}

.metric-label {
  color: var(--muted);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.5px;
}

.metric-value {
  margin-top: 8px;
  font-size: 24px;
  font-weight: 900;
}

.metric-hint {
  margin-top: 6px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 700;
}

.insight-box {
  margin-top: 16px;
  background: rgba(142,123,255,0.05);
  border: 1px solid rgba(142,123,255,0.18);
  border-radius: 14px;
  padding: 12px 14px;
}

.insight-copy {
  margin-top: 10px;
  color: var(--text);
  font-size: 13px;
  line-height: 1.7;
}

.insight-copy p {
  margin: 0 0 8px;
}

.analyze-btn {
  margin-top: 18px;
  width: 100%;
  border: 0;
  border-radius: 16px;
  background: linear-gradient(135deg, var(--blue), var(--green));
  color: #06121d;
  padding: 16px 20px;
  font-size: 17px;
  font-weight: 900;
  cursor: pointer;
  box-shadow: 0 16px 32px rgba(74,164,255,0.22);
}

.right-panel {
  padding: 18px 16px;
}

.metric-box {
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(148,163,184,0.14);
  border-radius: 14px;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.metric-row {
  font-size: 14px;
  color: var(--muted);
}

.metric-row strong {
  font-size: 22px;
  color: var(--text);
}

.toggle-btn {
  border: 1px solid rgba(148,163,184,0.14);
  background: rgba(255,255,255,0.02);
  color: var(--text);
  padding: 7px 12px;
  border-radius: 999px;
  font-weight: 800;
  cursor: pointer;
}

.toggle-btn.on {
  background: rgba(21,209,156,0.12);
  border-color: rgba(21,209,156,0.2);
  color: var(--green);
}

.mt5-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.mt5-form label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: var(--muted);
  font-weight: 700;
  font-size: 12px;
}

.mt5-form input {
  padding: 12px 14px;
  border-radius: 12px;
  border: 1px solid var(--line);
  background: rgba(255,255,255,0.02);
  color: var(--text);
}

.bot-status {
  margin-top: 18px;
  padding: 14px 12px;
  border-radius: 14px;
  background: rgba(142,123,255,0.04);
  border: 1px solid rgba(142,123,255,0.14);
}

.bot-status strong {
  display: block;
  margin-bottom: 6px;
  font-size: 15px;
}

.bot-status p {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
}

.notes-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 18px;
}

.note-item {
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(148,163,184,0.12);
  border-radius: 12px;
  padding: 12px;
  color: var(--text);
  font-size: 13px;
  line-height: 1.6;
}

@media (max-width: 1180px) {
  .dashboard {
    grid-template-columns: 1fr;
  }

  .signal-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  .topbar {
    flex-wrap: wrap;
  }

  .nav {
    width: 100%;
  }

  .pair-title {
    font-size: 24px;
  }

  .price-value {
    font-size: 24px;
  }

  .signal-grid {
    grid-template-columns: 1fr;
  }
}
